---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog · Sidequests" description="Notes from the side of the main quest, by Robin Pieterse.">
  <h1>Blog</h1>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        {post.data.tags && (
          <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
        )}
      </li>
    ))}
  </ul>
</Base>

<style>
  h1 {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    line-height: 0.98; letter-spacing: -0.035em; margin: 0 0 2.5rem;
  }
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts > li { padding: 1.75rem 0; border-top: 1px solid var(--rule); }
  .posts > li:last-child { border-bottom: 1px solid var(--rule); }
  time { font-family: var(--display); font-size: 0.9rem; color: var(--muted); }
  h2 {
    font-family: var(--display); font-weight: 600; font-size: 1.5rem;
    letter-spacing: -0.01em; margin: 0.25rem 0 0.5rem; overflow-wrap: anywhere;
  }
  p { margin: 0 0 0.75rem; max-width: 40rem; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .tags li {
    font-family: var(--display); font-size: 0.85rem; color: var(--muted);
    border: 1px solid var(--rule); border-radius: 6px; padding: 0.1rem 0.5rem;
  }
</style>
